        }
      },
      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "CodeSmile.AnyMotion.Core.SaveLoad.IFileIO",
      "Summary": "<p sourcefile=\"reference/CodeSmile.AnyMotion.Core.SaveLoad.IFileIO.yml\" sourcestartlinenumber=\"1\">Reads and writes preset text at a file path. Knows nothing about JSON or ScriptableObjects, so\nit can be swapped or mocked independently of both.</p>\n"
    },
    {
      "type": "ManagedReference",
      "source_relative_path": "reference/CodeSmile.AnyMotion.Core.SaveLoad.ISaveSystem.yml",
      "output": {
        ".html": {
          "relative_path": "reference/CodeSmile.AnyMotion.Core.SaveLoad.ISaveSystem.html"
        }
      },
      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "CodeSmile.AnyMotion.Core.SaveLoad.ISaveSystem",
      "Summary": "<p sourcefile=\"reference/CodeSmile.AnyMotion.Core.SaveLoad.ISaveSystem.yml\" sourcestartlinenumber=\"1\">Saves and loads preset-shaped data as text. Composes an <xref href=\"CodeSmile.AnyMotion.Core.SaveLoad.ITextSerializer\" data-throw-if-not-resolved=\"false\"></xref> and an\n<xref href=\"CodeSmile.AnyMotion.Core.SaveLoad.IFileIO\" data-throw-if-not-resolved=\"false\"></xref>; knows nothing about <code>PresetAsset&lt;T&gt;</code> or ScriptableObjects,\nso it is reusable for any serializable data, not only preset assets.</p>\n"
    },
    {
      "type": "ManagedReference",
      "source_relative_path": "reference/CodeSmile.AnyMotion.Core.SaveLoad.ITextSerializer.yml",
      "output": {
        ".html": {
          "relative_path": "reference/CodeSmile.AnyMotion.Core.SaveLoad.ITextSerializer.html"
        }
      },
      "version": "",
      "Uid": null,
      "IsMRef": true,
      "Title": "CodeSmile.AnyMotion.Core.SaveLoad.ITextSerializer",
      "Summary": "<p sourcefile=\"reference/CodeSmile.AnyMotion.Core.SaveLoad.ITextSerializer.yml\" sourcestartlinenumber=\"1\">Converts preset data to and from a text representation. Isolated behind an interface so the\nformat can change (eg JSON to a binary format) without touching file I/O or the save system\nthat composes this with it.</p>\n"
    },
    {
      "type": "ManagedReference",
      "source_relative_path": "reference/CodeSmile.AnyMotion.Core.SaveLoad.JsonUtilityTextSerializer.yml",
      "output": {
